# AI providers (server-side only). ASTRA tries them in order and moves on when one is missing,
# out of quota or slow. If none is set, ASTRA runs rules + URL checks without the AI layer.
# 1) Google Gemini (primary)
GEMINI_API_KEY=
# One model id, or a comma-separated list tried left to right (the next one is used if a model fails).
GEMINI_MODEL=
# 2) OpenRouter (backup). Model lists are comma-separated and tried left to right.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
OPENROUTER_VISION_MODEL=
# By default ASTRA tells OpenRouter not to use providers that log prompts, which excludes ":free"
# models. Set to 1 to allow them (your users' messages may then be logged or used for training).
OPENROUTER_ALLOW_DATA_COLLECTION=
# 3) OpenCode Zen (backup)
OPENCODE_API_KEY=
OPENCODE_TEXT_MODEL=
OPENCODE_VISION_MODEL=
# Optional: change the order, e.g. openrouter,gemini,opencode
AI_PROVIDER_ORDER=

# URL / file reputation (all optional; any provider that is unset is skipped and shown as "unavailable")
VIRUSTOTAL_API_KEY=

# Optional: Gemini model id. Default: gemini-3.5-flash-lite (stable, fastest 3.5 model as of 2026-11).
# Only letters, digits, dots, dashes and underscores are accepted.
# (GEMINI_MODEL above is kept; this comment documents the default.)

# Optional second URL reputation source: APIVoid Domain Reputation (free trial, no credit card).
# Only the hostname of a link is sent to APIVoid. Leave empty to disable.
APIVOID_API_KEY=

# Optional: override the local VirusTotal request budget (free key allows about 4 per minute).
VIRUSTOTAL_REQUESTS_PER_MINUTE=

# Phone number reputation from IPQualityScore (optional). The number is sent to IPQS.
IPQS_API_KEY=
